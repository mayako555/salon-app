rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSystemOwner() {
      return isSignedIn() && getUserData().role == "systemOwner";
    }

    function isPayrollMasterAdmin() {
      return isSignedIn() && (getUserData().role == "systemOwner" || getUserData().role == "payrollMasterAdmin");
    }

    function isTenantAdmin(tenantId) {
      return isSignedIn() && getUserData().tenant_id == tenantId && 
             (getUserData().role == "companyOwner" || getUserData().role == "payrollAdmin" || getUserData().role == "systemOwner");
    }

    // --- System Master Collections (Tenant Independent) ---
    // Only readable by everyone authenticated. Writable ONLY by SystemOwner/PayrollMasterAdmin.
    // Active masters cannot be updated or deleted directly via UI rules, but enforced via backend.
    
    match /master_health_insurance_rates/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
    }
    match /master_pension_rates/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
    }
    match /master_care_insurance_rates/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
    }
    match /master_employment_insurance_rates/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
    }
    match /master_childcare_support_rates/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
    }
    match /master_health_remuneration_brackets/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
    }
    match /master_pension_remuneration_brackets/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
    }
    match /master_income_tax_tables/{docId} {
      allow read: if isSignedIn();
      allow write: if isPayrollMasterAdmin();
      
      match /rows/{rowId} {
        allow read: if isSignedIn();
        allow write: if isPayrollMasterAdmin();
      }
    }

    // --- Tenant Specific Collections ---
    // Strict Tenant Isolation Enforcement
    
    match /staff_social_insurance_history/{docId} {
      allow read: if isTenantAdmin(resource.data.tenant_id);
      allow create: if isTenantAdmin(request.resource.data.tenant_id);
      allow update: if isTenantAdmin(resource.data.tenant_id) && isTenantAdmin(request.resource.data.tenant_id);
      allow delete: if false; // Hard delete not allowed
    }
    
    match /staff_employment_insurance_history/{docId} {
      allow read: if isTenantAdmin(resource.data.tenant_id);
      allow create: if isTenantAdmin(request.resource.data.tenant_id);
      allow update: if isTenantAdmin(resource.data.tenant_id) && isTenantAdmin(request.resource.data.tenant_id);
      allow delete: if false;
    }
    
    match /staff_income_tax_history/{docId} {
      allow read: if isTenantAdmin(resource.data.tenant_id);
      allow create: if isTenantAdmin(request.resource.data.tenant_id);
      allow update: if isTenantAdmin(resource.data.tenant_id) && isTenantAdmin(request.resource.data.tenant_id);
      allow delete: if false;
    }
    
    match /staff_resident_tax_schedules/{docId} {
      allow read: if isTenantAdmin(resource.data.tenant_id);
      allow create: if isTenantAdmin(request.resource.data.tenant_id);
      allow update: if isTenantAdmin(resource.data.tenant_id) && isTenantAdmin(request.resource.data.tenant_id);
      allow delete: if false;
    }
    
    match /staff_care_insurance_history/{docId} {
      allow read: if isTenantAdmin(resource.data.tenant_id);
      allow create: if isTenantAdmin(request.resource.data.tenant_id);
      allow update: if isTenantAdmin(resource.data.tenant_id) && isTenantAdmin(request.resource.data.tenant_id);
      allow delete: if false;
    }
    
    // Existing Monthly Statements (example pattern to enforce isolation)
    match /monthly_statements/{docId} {
      allow read: if isTenantAdmin(resource.data.tenant_id);
      allow create: if isTenantAdmin(request.resource.data.tenant_id);
      allow update: if isTenantAdmin(resource.data.tenant_id) && isTenantAdmin(request.resource.data.tenant_id);
      allow delete: if false; // Re-enforce no hard delete
    }

  }
}
