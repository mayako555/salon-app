rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSignedIn() && getUserData().active == true;
    }

    function isSystemOwner() {
      return isUserActive() && getUserData().role == "systemOwner";
    }

    // --- Users Collection ---
    // Users can read their own profile, or systemOwner can read all
    match /users/{userId} {
      allow read: if isSystemOwner() || (isSignedIn() && request.auth.uid == userId);
      // Writes are strictly done via Server Actions / Admin SDK
      allow write: if false; 
    }
    
    // --- Staff Profiles ---
    // Users can read their own staff profile (required for auth context initialization)
    match /staff_profiles/{profileId} {
      allow read: if isSystemOwner() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow write: if false; 
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /sales_master/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    
    // --- All Other Collections ---
    // By default, ALL direct client access is denied.
    // The application relies exclusively on Server Actions (Admin SDK) for reads and writes,
    // which guarantees that tenant isolation and access controls are strictly enforced.
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
