rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSignedIn() && getUserData().active == true;
    }

    function isSystemOwner() {
      return isUserActive() && getUserData().role == "systemOwner";
    }

    // Default: block everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    // Users can read their own profile, or systemOwner can read all
    match /users/{userId} {
      allow read: if isSystemOwner() || (isSignedIn() && request.auth.uid == userId);
      // Writes are strictly done via Server Actions / Admin SDK
      allow write: if false; 
    }

    
    // --- Staff Profiles ---
    // Users can read their own staff profile (required for auth context initialization)
    match /staff_profiles/{profileId} {
      // Allow read if system owner, OR if the email matches AND the user is active (or trying to become active)
      allow read: if isSystemOwner() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow write: if false; 
    }

    // --- General Collections (Read Only via Client SDK) ---
    // Instead of duplicating rules for every collection, we can use wildcards
    // BUT we must ensure the document actually has a companyId field!
    
    match /{collection}/{docId} {
      allow read: if isSystemOwner() || 
                  (isUserActive() && 
                   ((resource.data.companyId != null && resource.data.companyId == getUserData().companyId) ||
                    (resource.data.tenant_id != null && resource.data.tenant_id == getUserData().companyId)));
      // Writes are strictly done via Server Actions / Admin SDK
      allow write: if false;
    }
  }
}
